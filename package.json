{
  "name": "bba-sports-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Believers Badminton Academy — multi-centre coaching platform (BBA Sports Private Limited)",
  "workspaces": [
    "shared",
    "webapp",
    "functions"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=webapp",
    "build:shared": "npm run build --workspace=shared",
    "build:webapp": "npm run build --workspace=webapp",
    "build:functions": "npm run build --workspace=functions",
    "build": "npm run build:shared && npm run build:webapp && npm run build:functions",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
