{
  "name": "@bba/functions",
  "version": "0.1.0",
  "private": true,
  "description": "Firebase Cloud Functions backend for BBA Sports platform",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "clean": "rm -rf lib",
    "build": "npm run clean && node build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "serve": "npm run build && firebase emulators:start --only functions",
    "logs": "firebase functions:log"
  },
  "dependencies": {
    "firebase-admin": "^12.6.0",
    "firebase-functions": "^6.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "esbuild": "^0.28.0",
    "typescript": "^5.5.4"
  }
}
