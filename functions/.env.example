# =========================================================================================
# BBA Sports — Cloud Functions environment file (backend)
# -----------------------------------------------------------------------------------------
# Copy this file to `functions/.env`, fill in values, and NEVER commit the filled copy.
# =========================================================================================

# ---- Feature flags ----------------------------------------------------------------------
# Backend-side flags. Keep in sync with the VITE_* flags in webapp/.env.
RAZORPAY_LIVE=false
WHATSAPP_LIVE=false

# ---- Razorpay (fill when the current account is operational) ----------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Anthropic Claude (for AI-generated monthly progress reports) ------------------------
# claude-sonnet-4-6 is the model used for report generation.
ANTHROPIC_API_KEY=
CLAUDE_MODEL_ID=claude-sonnet-4-6

# ---- WhatsApp Business API (fill once approved) -----------------------------------------
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# ---- SMTP (attendance email notifications) ----------------------------------------------
# Used by onAttendanceRecordCreated to email attendance summaries.
# For Gmail: host=smtp.gmail.com, port=587, user=your@gmail.com, pass=16-char app password
SMTP_HOST= smtp.hostinger.com
SMTP_PORT=465
SMTP_USER= hello@bbashuttle.com
SMTP_PASS= Believers@250403
EMAIL_FROM=BBA Sports Academy <noreply@bbasports.in>

# ---- Other ------------------------------------------------------------------------------
# Logging verbosity for the functions runtime.
LOG_LEVEL=info

# ---- Google Sheets Integration (Apps Script → Firebase) ----------------------------------
# API key that the Apps Script uses in the x-api-key header when calling submitFeePayment.
# Generate a random 32+ char key and share it with the Sheets script.
SHEETS_API_KEY=812f9c987cded3d3f8903aef29819b7d31047c46

# ---- Google Sheets API (Firebase → Sheets) -----------------------------------------------
# Service account JSON (single line) with Editor access to the BBA Automation Hub spreadsheet.
# Grant access by sharing the sheet with the service account email.
GOOGLE_SERVICE_ACCOUNT_JSON=
