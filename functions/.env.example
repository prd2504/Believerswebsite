# =========================================================================================
# BBA Sports — Cloud Functions environment file (backend)
# -----------------------------------------------------------------------------------------
# ⚠️  IMPORTANT: Firebase loads ONLY `functions/.env` (and `.env.<projectId>`).
#     It does NOT read this `.env.example`. Put real values in `functions/.env`,
#     then redeploy. Editing this file alone changes nothing in production.
#     Do not put a space after `=` — write KEY=value, not KEY= value.
# =========================================================================================

# ---- Feature flags ----------------------------------------------------------------------
# Backend-side flags. Keep in sync with the VITE_* flags in webapp/.env.
RAZORPAY_LIVE=false
WHATSAPP_LIVE=false

# ---- Razorpay (fill when the current account is operational) ----------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Anthropic Claude (for AI-generated monthly progress reports) ------------------------
# claude-sonnet-4-6 is the model used for report generation.
ANTHROPIC_API_KEY=
CLAUDE_MODEL_ID=claude-sonnet-4-6

# ---- WhatsApp Business API (fill once approved) -----------------------------------------
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# ---- SMTP (invoice + attendance + payslip emails) ---------------------------------------
# Hostinger: host=smtp.hostinger.com, port=465 (secure).
# EMAIL_FROM must use the SAME domain as SMTP_USER, or Hostinger rejects the send
# (550 sender not allowed). Use a bbashuttle.com address, not bbasports.in.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=hello@bbashuttle.com
SMTP_PASS=
EMAIL_FROM=BBA Sports Academy <hello@bbashuttle.com>

# ---- Other ------------------------------------------------------------------------------
# Logging verbosity for the functions runtime.
LOG_LEVEL=info

# ---- Google Sheets Integration (Apps Script → Firebase) ----------------------------------
# API key that the Apps Script uses in the x-api-key header when calling submitFeePayment.
# Generate a random 32+ char key and share it with the Sheets script.
SHEETS_API_KEY=

# ---- Google Sheets API (Firebase → Sheets) -----------------------------------------------
# Service account with Editor access to the BBA Automation Hub spreadsheet
# (share the sheet with the service account's client_email).
#
# RECOMMENDED — base64 of the JSON file (immune to .env newline/quote mangling):
#   Linux:  base64 -w0 service-account.json
#   macOS:  base64 -i service-account.json
# Paste the single-line output here:
GOOGLE_SERVICE_ACCOUNT_BASE64=
#
# ALTERNATIVE — raw JSON on ONE line (only if it stays valid single-line JSON):
GOOGLE_SERVICE_ACCOUNT_JSON=
