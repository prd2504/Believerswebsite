# =========================================================================================
# BBA Sports — Webapp environment file (frontend)
# -----------------------------------------------------------------------------------------
# Copy this file to `webapp/.env` for local dev. The values below are the REAL Firebase
# web client config for project `bba-sports-prod` — safe to commit in `.env.example`
# because Firebase web config is a public identifier (security is enforced via rules).
#
# Actual secrets (Razorpay, WhatsApp, Anthropic) belong in `functions/.env` on the
# backend — never in webapp/.env, because VITE_ variables are exposed to the browser.
# =========================================================================================

# ---- Firebase web client config ---------------------------------------------------------
VITE_FIREBASE_API_KEY=AIzaSyD9KCSRkCrFOjk6UJ59oA53hWd8y1vDkNc
VITE_FIREBASE_AUTH_DOMAIN=bba-sports-prod.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=bba-sports-prod
VITE_FIREBASE_STORAGE_BUCKET=bba-sports-prod.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=835553707248
VITE_FIREBASE_APP_ID=1:835553707248:web:2c69e81d12830464abae35
VITE_FIREBASE_MEASUREMENT_ID=G-8E22P692S1

# ---- Feature flags ----------------------------------------------------------------------
VITE_RAZORPAY_LIVE=false
VITE_WHATSAPP_LIVE=false

# ---- Razorpay (fill when live) ----------------------------------------------------------
# Only the public key id goes in the browser bundle. The key secret lives ONLY in
# functions/.env — never here.
VITE_RAZORPAY_KEY_ID=

# ---- Functions region override (optional) ----------------------------------------------
# If you later deploy functions to a different region, override it here.
VITE_FUNCTIONS_REGION=asia-south1
