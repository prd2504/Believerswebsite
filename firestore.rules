rules_version = '2';

// =========================================================================================
// BBA Sports — Firestore Security Rules (Production)
// -----------------------------------------------------------------------------------------
// Enforce RBAC at the database level. Compromised frontend code cannot escalate privileges.
//
// After editing, paste in Firebase Console → Firestore → Rules and click "Publish".
// Allow ~30 seconds to propagate.
// =========================================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ──────────────────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function getUserDoc() {
      return get(/databases/$(database)/documents/users/$(uid()));
    }

    function getRole() {
      return getUserDoc().data.role;
    }

    function isSuperAdmin() {
      return isSignedIn() && getRole() == 'SUPER_ADMIN';
    }

    function isCentreManager() {
      return isSignedIn() && getRole() == 'CENTRE_MANAGER';
    }

    function isAdminLike() {
      return isSignedIn() && getRole() in ['SUPER_ADMIN', 'CENTRE_MANAGER'];
    }

    function isCoach() {
      return isSignedIn() && getRole() == 'COACH';
    }

    function isAdminOrCoach() {
      return isSignedIn() && getRole() in ['SUPER_ADMIN', 'CENTRE_MANAGER', 'COACH'];
    }

    function isStudentOrParent() {
      return isSignedIn() && getRole() in ['STUDENT', 'PARENT'];
    }

    // Check if the user's centreIds includes a given centreId (for scoped managers)
    function managedCentreIds() {
      return getUserDoc().data.centreIds;
    }

    function managesCentre(centreId) {
      return isSuperAdmin() || (isCentreManager() && centreId in managedCentreIds());
    }

    // ── /users/{userId} ───────────────────────────────────────────────────────────────────
    match /users/{userId} {
      // Own profile or admin can read
      allow read: if isSignedIn() && (uid() == userId || isAdminLike());

      // Self-create on first login
      allow create: if isSignedIn() && uid() == userId;

      // Self can update own mutable fields; super-admin can update any field including role
      allow update: if isSignedIn() && (
        uid() == userId && !('role' in request.resource.data.diff(resource.data).affectedKeys())
      ) || isSuperAdmin();

      // Only super-admin can delete
      allow delete: if isSuperAdmin();
    }

    // ── /centres/{centreId} ───────────────────────────────────────────────────────────────
    match /centres/{centreId} {
      // All signed-in users can read centres (needed for selecting batches, etc.)
      allow read: if isSignedIn();
      // Admin-like can write. Managers can only write to their own centres.
      allow create: if isAdminLike();
      allow update, delete: if managesCentre(centreId);
    }

    // ── /batches/{batchId} ────────────────────────────────────────────────────────────────
    match /batches/{batchId} {
      allow read: if isSignedIn();
      allow create: if isAdminLike();
      // Admins + coaches (updating studentIds/currentEnrolment) can write
      allow update: if isAdminLike() || isCoach();
      allow delete: if isAdminLike();
    }

    // ── /students/{studentId} ─────────────────────────────────────────────────────────────
    match /students/{studentId} {
      // Admin + coaches can read all; students/parents can only read their linked profiles
      allow read: if isAdminOrCoach() || (
        isStudentOrParent() && studentId in getUserDoc().data.linkedStudentIds
      );
      allow create: if isAdminLike();
      allow update: if isAdminLike();
      allow delete: if isAdminLike();
    }

    // ── /attendance/{batchId}/sessions/{sessionId}/records/{studentId} ───────────────────
    match /attendance/{batchId}/sessions/{sessionId} {
      allow read: if isAdminOrCoach() || isStudentOrParent();
      allow write: if isAdminOrCoach();

      match /records/{recordId} {
        allow read: if isAdminOrCoach() || isStudentOrParent();
        allow write: if isAdminOrCoach();
      }
    }

    // ── /payments/{paymentId} ─────────────────────────────────────────────────────────────
    match /payments/{paymentId} {
      // Coaches cannot see payment data
      allow read: if isAdminLike() || (
        isStudentOrParent() && (
          resource.data.studentId in getUserDoc().data.linkedStudentIds ||
          resource.data.studentId == uid()
        )
      );
      allow create: if isAdminLike();
      allow update: if isAdminLike();
      allow delete: if isSuperAdmin();
    }

    // ── /progress/{studentId}/scores & reports ────────────────────────────────────────────
    match /progress/{studentId} {
      match /{subcol}/{docId} {
        allow read: if isAdminOrCoach() || (
          isStudentOrParent() && (
            studentId in getUserDoc().data.linkedStudentIds || studentId == uid()
          )
        );
        allow write: if isAdminOrCoach();
      }
    }

    // ── /tournaments/{tournamentId} ───────────────────────────────────────────────────────
    match /tournaments/{tournamentId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdminLike();

      match /registrations/{studentId} {
        allow read: if isSignedIn();
        // Students/parents can register/unregister themselves; admins can do anything
        allow create: if isSignedIn() && (
          isAdminLike() || studentId in getUserDoc().data.linkedStudentIds || studentId == uid()
        );
        allow delete: if isAdminLike() || (
          isStudentOrParent() && (studentId in getUserDoc().data.linkedStudentIds || studentId == uid())
        );
        allow update: if isAdminLike();
      }
    }

    // ── /notifications/{userId}/messages/{notifId} ───────────────────────────────────────
    match /notifications/{userId} {
      match /messages/{notifId} {
        // Users can only read/mark-read their own notifications
        allow read: if isSignedIn() && uid() == userId;
        // Users can mark their own as read (update 'read' and 'readAt' only)
        allow update: if isSignedIn() && uid() == userId;
        // Cloud Functions (admin SDK) create; admin-like users can also create
        allow create: if isAdminLike();
        allow delete: if isAdminLike();
      }
    }

    // ── /broadcasts/{broadcastId} ─────────────────────────────────────────────────────────
    match /broadcasts/{broadcastId} {
      allow read: if isAdminLike();
      allow create: if isAdminLike();
      allow update, delete: if isSuperAdmin();
    }
  }
}
