rules_version = '2';

// =========================================================================================
// BBA Sports — Firestore Security Rules (Production)
// -----------------------------------------------------------------------------------------
// Enforce RBAC at the database level. Compromised frontend code cannot escalate privileges.
//
// After editing, paste in Firebase Console → Firestore → Rules and click "Publish".
// Allow ~30 seconds to propagate.
// =========================================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ──────────────────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function getUserDoc() {
      return get(/databases/$(database)/documents/users/$(uid()));
    }

    function getRole() {
      return getUserDoc().data.role;
    }

    function isSuperAdmin() {
      return isSignedIn() && getRole() == 'SUPER_ADMIN';
    }

    function isCentreManager() {
      return isSignedIn() && getRole() == 'CENTRE_MANAGER';
    }

    function isAdminLike() {
      return isSignedIn() && getRole() in ['SUPER_ADMIN', 'CENTRE_MANAGER'];
    }

    function isActiveCoach() {
      // Missing accountStatus field (existing docs) defaults to ACTIVE
      return isSignedIn() && getRole() == 'COACH' && (
        !('accountStatus' in getUserDoc().data) ||
        getUserDoc().data.accountStatus == 'ACTIVE'
      );
    }

    function isCoach() {
      return isActiveCoach();
    }

    function isAdminOrCoach() {
      return isSignedIn() && (
        getRole() in ['SUPER_ADMIN', 'CENTRE_MANAGER'] || isActiveCoach()
      );
    }

    function isStudentOrParent() {
      return isSignedIn() && getRole() in ['STUDENT', 'PARENT'];
    }

    // Check if the user's centreIds includes a given centreId (for scoped managers)
    function managedCentreIds() {
      return getUserDoc().data.centreIds;
    }

    function isAllCentreManager() {
      return isCentreManager() && getUserDoc().data.allCentreAccess == true;
    }

    function managesCentre(centreId) {
      return isSuperAdmin() || isAllCentreManager() || (isCentreManager() && centreId in managedCentreIds());
    }

    // ── /users/{userId} ───────────────────────────────────────────────────────────────────
    match /users/{userId} {
      // Own profile or admin can read
      allow read: if isSignedIn() && (uid() == userId || isAdminLike());

      // Self-create on first login
      allow create: if isSignedIn() && uid() == userId;

      // Self can update own mutable fields; super-admin can update any field including role
      allow update: if isSignedIn() && (
        uid() == userId && !('role' in request.resource.data.diff(resource.data).affectedKeys())
      ) || isSuperAdmin();

      // Only super-admin can delete
      allow delete: if isSuperAdmin();
    }

    // ── /centres/{centreId} ───────────────────────────────────────────────────────────────
    match /centres/{centreId} {
      // Public can read active centres (for /fees page). Signed-in users can read all.
      allow read: if resource.data.active == true || isSignedIn();
      // Admin-like can write. Managers can only write to their own centres.
      allow create: if isAdminLike();
      allow update, delete: if managesCentre(centreId);
    }

    // ── /batches/{batchId} ────────────────────────────────────────────────────────────────
    match /batches/{batchId} {
      allow read: if isSignedIn();
      allow create: if isAdminLike();
      // Admins + coaches (updating studentIds/currentEnrolment) can write
      allow update: if isAdminLike() || isCoach();
      allow delete: if isAdminLike();
    }

    // ── /students/{studentId} ─────────────────────────────────────────────────────────────
    match /students/{studentId} {
      // Admin + coaches can read all; students/parents can only read their linked profiles
      allow read: if isAdminOrCoach() || (
        isStudentOrParent() && studentId in getUserDoc().data.linkedStudentIds
      );
      allow create: if isAdminLike();
      allow update: if isAdminLike();
      allow delete: if isAdminLike();

      // Denormalised monthly attendance summary written by Cloud Function
      match /attendanceMonthly/{yearMonth} {
        allow read: if isAdminOrCoach() || (
          isStudentOrParent() && studentId in getUserDoc().data.linkedStudentIds
        );
        allow write: if isAdminLike();  // CF uses admin SDK which bypasses rules
      }
    }

    // ── /enrollments/{enrollmentId} ──────────────────────────────────────────────────────
    // One row per (student, batch). Admins and the centre's manager create + update.
    // Students/parents read their own. Coaches read enrollments for their batches
    // (needed to derive today's roster).
    match /enrollments/{enrollmentId} {
      allow read: if isAdminOrCoach() || (
        isStudentOrParent() && resource.data.studentId in getUserDoc().data.linkedStudentIds
      );
      allow create: if isAdminLike();
      allow update: if isAdminLike();
      allow delete: if isSuperAdmin();
    }

    // ── /attendance/{batchId}/sessions/{sessionId}/records/{studentId} ───────────────────
    match /attendance/{batchId}/sessions/{sessionId} {
      allow read: if isAdminOrCoach() || isStudentOrParent();
      allow write: if isAdminOrCoach();

      match /records/{recordId} {
        allow read: if isAdminOrCoach() || isStudentOrParent();
        allow write: if isAdminOrCoach();
      }
    }

    // ── /payments/{paymentId} ─────────────────────────────────────────────────────────────
    match /payments/{paymentId} {
      // Coaches cannot see payment data
      allow read: if isAdminLike() || (
        isStudentOrParent() && (
          resource.data.studentId in getUserDoc().data.linkedStudentIds ||
          resource.data.studentId == uid()
        )
      );
      allow create: if isAdminLike();
      allow update: if isAdminLike();
      allow delete: if isSuperAdmin();
    }

    // ── /progress/{studentId}/scores & reports ────────────────────────────────────────────
    match /progress/{studentId} {
      match /{subcol}/{docId} {
        allow read: if isAdminOrCoach() || (
          isStudentOrParent() && (
            studentId in getUserDoc().data.linkedStudentIds || studentId == uid()
          )
        );
        allow write: if isAdminOrCoach();
      }
    }

    // ── /parentFeedback/{feedbackId} ────────────────────────────────────────────────────────
    match /parentFeedback/{feedbackId} {
      allow read: if isAdminLike();
      allow create, update: if isAdminLike();
      allow delete: if isSuperAdmin();
    }

    // ── /centreExpenses/{expenseId} — SUPER_ADMIN ONLY ───────────────────────────────────
    // Expenses include COACH_SALARY rows (booked automatically when payroll is
    // paid) and drive the profit view. This is finance data a CENTRE_MANAGER
    // must never see or edit — read/write is SUPER_ADMIN only, matching
    // partnerPayouts and the payroll collections.
    match /centreExpenses/{expenseId} {
      allow read: if isSuperAdmin();
      allow create, update: if isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // ── /recurringExpenses/{templateId} — SUPER_ADMIN ONLY ───────────────────────────────
    // Templates for fixed monthly costs (rent, utilities). Same finance-only
    // sensitivity as centreExpenses, which is what they post into.
    match /recurringExpenses/{templateId} {
      allow read: if isSuperAdmin();
      allow create, update: if isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // ── /partnerPayouts/{payoutId} — SUPER_ADMIN ONLY ───────────────────────────────────
    match /partnerPayouts/{payoutId} {
      allow read: if isSuperAdmin();
      allow create, update: if isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // ── /issues/{issueId} ───────────────────────────────────────────────────────────────
    match /issues/{issueId} {
      allow read: if isAdminOrCoach();
      allow create: if isAdminOrCoach();
      allow update: if isAdminOrCoach();
      allow delete: if isAdminLike();

      match /comments/{commentId} {
        allow read: if isAdminOrCoach();
        allow create: if isAdminOrCoach();
        allow update: if isSignedIn() && resource.data.authorId == uid();
        allow delete: if isAdminLike();
      }
    }

    // ── /notifications/{userId}/messages/{notifId} ───────────────────────────────────────
    match /notifications/{userId} {
      match /messages/{notifId} {
        // Users can only read/mark-read their own notifications
        allow read: if isSignedIn() && uid() == userId;
        // Users can mark their own as read (update 'read' and 'readAt' only)
        allow update: if isSignedIn() && uid() == userId;
        // Cloud Functions (admin SDK) create; admin-like users can also create
        allow create: if isAdminLike();
        allow delete: if isAdminLike();
      }
    }

    // ── /slotBookings/{bookingId} — PUBLIC booking portal ────────────────────────────────
    match /slotBookings/{bookingId} {
      allow read: if true;
      allow create: if
        request.resource.data.participantName is string &&
        request.resource.data.participantName.size() > 0 &&
        request.resource.data.participantPhone is string &&
        request.resource.data.participantPhone.size() >= 10 &&
        request.resource.data.planType in ['TWO_DAY', 'THREE_DAY', 'FOUR_DAY', 'GAMES_DAY', 'COMPLETE_BUNDLE'] &&
        request.resource.data.status == 'PENDING_PAYMENT';
      allow update: if isAdminLike();
      allow delete: if isSuperAdmin();
    }

    // ── /paymentMonthlySummaries/{summaryId} — admin-only monthly rollups ─────────────────
    match /paymentMonthlySummaries/{summaryId} {
      allow read: if isAdminLike();
      allow create, update: if isAdminLike();
      allow delete: if isSuperAdmin();
    }

    // ── /slotBookingConfig/{centreId} — Portal config (public read, admin write) ──────────
    match /slotBookingConfig/{centreId} {
      allow read: if true;
      allow write: if isAdminLike();
    }

    // ── /staff/{staffId} — Coach payroll profiles (SUPER_ADMIN only) ───────────────────
    match /staff/{staffId} {
      allow read: if isSuperAdmin() || (
        isCoach() && resource.data.authUid == uid()
      );
      allow create, update: if isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // ── /payrollRuns/{runId} — Monthly payroll entries ─────────────────────────────
    match /payrollRuns/{runId} {
      allow read: if isSuperAdmin() || (
        isCoach() && get(/databases/$(database)/documents/staff/$(resource.data.staffId)).data.authUid == uid()
      );
      allow create, update: if isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // ── /emailDigests/{digestId} — Attendance email dedup (Cloud Functions only) ──────
    match /emailDigests/{digestId} {
      allow read, write: if false;
    }

    // ── /broadcasts/{broadcastId} ─────────────────────────────────────────────────────────
    match /broadcasts/{broadcastId} {
      allow read: if isAdminLike();
      allow create: if isAdminLike();
      allow update, delete: if isSuperAdmin();
    }
  }
}
